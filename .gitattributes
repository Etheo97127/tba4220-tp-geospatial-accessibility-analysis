# Tables the pipeline writes have LF line endings (readr), so check every CSV out
# with LF: otherwise a fresh run on Windows shows each table as modified.
*.csv text eol=lf

# Raw downloads stay byte-for-byte what the source served, because their md5s are
# logged in docs/data_log.md. Most were served with LF and are stored as-is.
data/raw/** -text

# These four were served with CRLF but committed as LF blobs, so they are checked
# out with CRLF: that rebuilds the served bytes and their logged md5s.
data/raw/sg/childcare_services.geojson text eol=crlf
data/raw/sg/kindergartens.geojson text eol=crlf
data/raw/sg/mp19_subzone.geojson text eol=crlf
data/raw/sg/mp19_rail_station.geojson text eol=crlf
